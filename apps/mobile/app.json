{
  "expo": {
    "name": "KouriGo",
    "slug": "kourigo",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "cover",
      "backgroundColor": "#014B20"
    },
    "android": {
      "package": "com.kourigo.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#014B20"
      }
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "KouriGo accede a tus fotos solo para tu foto de perfil. / KouriGo aksè foto ou sèlman pou foto pwofil ou.",
          "cameraPermission": false
        }
      ]
    ]
  }
}
