# =============================================================================
# KouriGo — ejemplo de configuración de entorno (SIN valores secretos)
# Copiar a .env y completar en cada entorno. Nunca commitear valores reales.
# =============================================================================

# --- Aplicaciones cliente (móvil/consola web): valores públicos por diseño ---
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# --- Servidor / Edge Functions: SOLO entornos de servidor ---
# La clave service-role es privilegiada: nunca exponer con prefijo público,
# nunca en el bundle móvil, el frontend, el repositorio ni los builds públicos.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- Base de datos (migraciones y CI) ---
DATABASE_URL=

# --- Proveedores de pago: solo con documentación y credenciales oficiales ---
# No inventar endpoints ni simular confirmaciones (README sección 6).
MONCASH_CLIENT_ID=
MONCASH_CLIENT_SECRET=
NATCASH_CLIENT_ID=
NATCASH_CLIENT_SECRET=
